# Mock/dummy backend flag. When true (default), axios calls are answered by
# an in-memory adapter — see src/lib/mock/install.ts. Set to false to hit
# the real Spring Boot backend at VITE_API_BASE_URL.
VITE_USE_MOCK=true

# Base URL of the Spring Boot backend (no trailing slash).
# The Axios client appends /api/v1 automatically.
VITE_API_BASE_URL=http://localhost:8080
